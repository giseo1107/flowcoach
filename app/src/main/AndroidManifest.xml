<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive(Pleos Connect) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 공공 교통정보 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 실시간 주행 모드: 위치·속도·진행 방향 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "지금 어때?" 음성 질문 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Pleos Vehicle SDK: 방향지시등(TurnSignal) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- Pleos Vehicle SDK: 브레이크 페달(Brake), 크루즈(DrivingMode) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Pleos NaviHelper SDK: 현재 위치·진행 방향·현재 도로 제한속도(get*Info, 보호 수준 Normal) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- AAOS 표준 차량 API: 실제 차속(PERF_VEHICLE_SPEED) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- AAOS 표준 차량 API: 기어(GEAR_SELECTION) — P·R·N이면 코칭을 쉰다 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- 내비를 띄워 둬도 코칭이 계속되도록 주행 중 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+에서 TTS 엔진·음성 인식 서비스를 찾기 위해 필요 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowCoach">

        <!-- AAOS 차량 API 라이브러리(없는 기기에서도 앱은 설치되도록 required=false) -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- 주행 화면: 주행 중에도 보여야 하므로 운전 집중 방해 최적화(DO) 선언 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 실제 도로 시연 준비 화면: 주차 중에만 쓰므로 DO를 선언하지 않음 -->
        <activity
            android:name=".ui.RouteDemoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 리포트 화면: DO를 선언하지 않음 → 주행 중에는 시스템이 막고, 정차 시에만 열림 -->
        <activity
            android:name=".ui.ReportActivity"
            android:exported="false" />

        <!-- 주행 중 백그라운드 유지(실제 주행 모드에서 위치를 쓰므로 location 타입) -->
        <service
            android:name=".session.CoachService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>

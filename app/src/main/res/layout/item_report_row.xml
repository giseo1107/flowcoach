<?xml version="1.0" encoding="utf-8"?>
<!-- 리포트 '점수에서 빠진 것' 한 줄: 왼쪽 = 항목·한 줄 설명, 오른쪽 = 횟수(시간)·감점 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_high" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/gap"
        android:paddingBottom="@dimen/gap">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                tools:text="추월 후 미복귀" />

            <TextView
                android:id="@+id/row_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="추월을 마치면 오른쪽 차로로 돌아가요" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="1회" />

            <TextView
                android:id="@+id/row_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/state_slow"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                tools:text="−10점" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

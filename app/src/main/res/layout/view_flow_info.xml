<?xml version="1.0" encoding="utf-8"?>
<!-- 게이지 아래 숫자 세 칸: 권장 속도(가장 중요) · 제한 · 흐름. 세로·가로 주행 화면이 같이 쓴다.
     길게 누르면 실시간 교통정보 ↔ 가정값 전환(개발용, 나중에 설정 › 개발자 옵션으로 옮긴다) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flow_info_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="@dimen/gap"
    android:paddingBottom="@dimen/gap">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_rec_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_number_large"
            android:textStyle="bold"
            tools:text="98" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/info_recommended"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/gauge_track" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_limit_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_number"
            tools:text="110" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/info_limit"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/gauge_track" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_flow_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_number"
            tools:text="91" />

        <TextView
            android:id="@+id/info_flow_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/info_flow"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label"
            tools:text="흐름 · 실시간" />
    </LinearLayout>
</LinearLayout>
